# Supabase Configuration
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# (Opcional) Sobrescribe la URL del webhook de n8n. Útil para apuntar a un
# workflow DEV en local sin tocar el código. Si no se define, usa el webhook
# de producción (pdf-upload).
# VITE_N8N_WEBHOOK_URL=https://sanaladas-n8n.lytrap.easypanel.host/webhook/pdf-upload-dev

# For Netlify Functions (serverless endpoints)
SUPABASE_URL=your-supabase-url
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Ejemplo:
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key-here
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here